rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 앱마다 apps/{appId}/events 아래에만 쓴다. 새 앱을 추가하려면 이 목록에 id를 더한다.
    // 누구나 읽을 수 있다 (통계 대시보드가 로그인 없이 본다). 쓰기는 추가만 되고,
    // 이미 쓴 기록은 아무도 고치거나 지울 수 없다 (콘솔의 관리자 권한은 이 규칙과 무관하게 항상 된다).
    match /apps/{appId}/events/{eventId} {
      allow read: if true;
      allow update, delete: if false;
      allow create: if appId in ['kinship']
        && request.resource.data.type is string
        && request.resource.data.type.size() < 40
        && request.resource.data.ts == request.time;
    }
  }
}
