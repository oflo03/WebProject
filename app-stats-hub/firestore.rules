rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      // 대시보드 로그인 계정만 통계를 볼 수 있다. 다른 이메일과 같이 쓰려면 여기 추가한다.
      return request.auth != null && request.auth.token.email == 'samleebw03@gmail.com';
    }

    // 앱마다 apps/{appId}/events 아래에만 쓴다. 새 앱을 추가하려면 이 목록에 id를 더한다.
    // 클라이언트는(로그인 없이) 이벤트를 추가만 할 수 있다. 읽기·삭제는 로그인한 소유자만,
    // 수정은 기록을 조작하지 못하도록 아무도 할 수 없다.
    match /apps/{appId}/events/{eventId} {
      allow read, delete: if isOwner();
      allow update: if false;
      allow create: if appId in ['kinship']
        && request.resource.data.type is string
        && request.resource.data.type.size() < 40
        && request.resource.data.ts == request.time;
    }
  }
}
