rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 앱마다 apps/{appId} 아래에만 쓴다. 새 앱을 추가하려면 이 목록에 id를 더한다.
    // 누구나 읽을 수 있다 (통계 대시보드가 로그인 없이 본다).

    // 원본 로그: 추가만 되고, 이미 쓴 기록은 아무도 고치거나 지울 수 없다.
    match /apps/{appId}/events/{eventId} {
      allow read: if true;
      allow update, delete: if false;
      allow create: if appId in ['kinship', 'speeder']
        && request.resource.data.type is string
        && request.resource.data.type.size() < 40
        && request.resource.data.ts == request.time;
    }

    // 집계 카운터: 이벤트를 남길 때마다 숫자만 늘어난다 (increment). 문서 하나뿐이라 통계 새로고침이 가볍다.
    match /apps/{appId}/counters/summary {
      allow read: if true;
      allow write: if appId in ['kinship', 'speeder'];
    }

    // 날짜별 카운터 (일별 그래프용). 문서 id 가 YYYY-MM-DD 형식인지만 본다.
    match /apps/{appId}/daily/{date} {
      allow read: if true;
      allow write: if appId in ['kinship', 'speeder'] && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // 인당 플레이 횟수를 세려고, 브라우저별 식별자를 처음 볼 때만 기록해둔다 (있는지 여부만 쓴다).
    match /apps/{appId}/users/{clientId} {
      allow read: if true;
      allow create: if appId in ['kinship', 'speeder'];
      allow update, delete: if false;
    }

    // 스피더 포르세우스(힌트 없음) 클리어 랭킹. 난이도별로 따로, 추가만 되고 고칠 수 없다.
    match /apps/{appId}/rankings/{mode}/entries/{entryId} {
      allow read: if true;
      allow update, delete: if false;
      allow create: if appId == 'speeder'
        && mode in ['easy', 'normal', 'hard']
        && request.resource.data.keys().hasOnly(['name', 'ms', 'moves', 'clientId', 'ts'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 12
        && request.resource.data.ms is int
        && request.resource.data.ms > 0
        && request.resource.data.ms < 86400000
        && request.resource.data.moves is int
        && request.resource.data.moves > 0
        && request.resource.data.clientId is string
        && request.resource.data.clientId.size() < 64
        && request.resource.data.ts == request.time;
    }
  }
}
